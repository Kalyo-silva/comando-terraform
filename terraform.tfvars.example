aws_region           = "us-east-1"
project_name         = "aws-academy"
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

ec2_instance_type         = "t2.medium"
asg_min_size              = 1
asg_desired_capacity      = 2
asg_max_size              = 4
asg_cpu_target            = 60
ssh_allowed_cidrs         = []
ec2_instance_profile_name = "LabInstanceProfile"

db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "comando"
db_master_username   = "comando"

application_repository_url = "https://github.com/CarlosEduardo-N-O/comando.git"
application_commit_sha     = "0f9e06f9ae3456c3905fbc96d7857ca7d0e3c5f8"
initial_admin_name         = "Administrador"
initial_admin_email        = "admin@comando.local"
